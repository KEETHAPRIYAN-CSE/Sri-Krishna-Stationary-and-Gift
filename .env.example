# ============================================================
# SRI KRISHNA STATIONERY AND GIFT - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# FRONTEND CONFIGURATION (Sri-Krishna-Stationery-Gift/frontend/.env)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_WHATSAPP_NUMBER=919876543210

# Firebase Client SDK Configuration (Get from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Razorpay Client Key (Key ID ONLY - Never expose Razorpay Secret in Frontend!)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# ------------------------------------------------------------
# BACKEND CONFIGURATION (Sri-Krishna-Stationery-Gift/backend/.env)
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Note: In .env, replace actual newlines in private key with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Razorpay API Credentials (From Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Store / Admin Details
ADMIN_EMAIL=admin@srikrishnastationery.com
STORE_NAME="Sri Krishna Stationery and Gift"
STORE_PHONE="+91 98765 43210"
STORE_ADDRESS="2/363 Sri Kumaran Complex, Siruvani Main Road, Kalampalayam, Coimbatore - 641010"
